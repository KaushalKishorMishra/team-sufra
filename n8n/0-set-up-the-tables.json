    {
      "parameters": {
        "jsCode": "// Huda's menu, in AED. The unit says what each price is per: guest, child, cake, person or event.\nreturn [\n  {\n    \"service_id\": \"classic_buffet\",\n    \"name\": \"Classic buffet\",\n    \"name_ar\": \"بوفيه كلاسيكي\",\n    \"price\": 85,\n    \"unit\": \"guest\",\n    \"includes\": \"Two mains, rice, three salads, bread and one dessert\"\n  },\n  {\n    \"service_id\": \"premium_buffet\",\n    \"name\": \"Premium buffet\",\n    \"name_ar\": \"بوفيه مميز\",\n    \"price\": 140,\n    \"unit\": \"guest\",\n    \"includes\": \"Four mains with a live grill station, rice, five salads, bread and two desserts\"\n  },\n  {\n    \"service_id\": \"canape_platters\",\n    \"name\": \"Canapé platters\",\n    \"name_ar\": \"أطباق المقبلات\",\n    \"price\": 45,\n    \"unit\": \"guest\",\n    \"includes\": \"Eight bites per guest, hot and cold, for receptions and standing events\"\n  },\n  {\n    \"service_id\": \"kids_menu\",\n    \"name\": \"Kids' menu\",\n    \"name_ar\": \"قائمة الأطفال\",\n    \"price\": 35,\n    \"unit\": \"child\",\n    \"includes\": \"Mini burgers, chicken bites, fruit cups and a juice box\"\n  },\n  {\n    \"service_id\": \"drinks\",\n    \"name\": \"Soft drinks and juices\",\n    \"name_ar\": \"مشروبات غازية وعصائر\",\n    \"price\": 15,\n    \"unit\": \"guest\",\n    \"includes\": \"Water, soft drinks and two fresh juices, served for four hours\"\n  },\n  {\n    \"service_id\": \"celebration_cake\",\n    \"name\": \"Celebration cake\",\n    \"name_ar\": \"كعكة الاحتفال\",\n    \"price\": 320,\n    \"unit\": \"cake\",\n    \"includes\": \"Serves 30, one flavor, a name or message on top\"\n  },\n  {\n    \"service_id\": \"service_staff\",\n    \"name\": \"Service staff\",\n    \"name_ar\": \"طاقم الخدمة\",\n    \"price\": 220,\n    \"unit\": \"person\",\n    \"includes\": \"One server for four hours: setting up, serving and clearing\"\n  },\n  {\n    \"service_id\": \"delivery_setup\",\n    \"name\": \"Delivery and setup\",\n    \"name_ar\": \"التوصيل والتجهيز\",\n    \"price\": 150,\n    \"unit\": \"event\",\n    \"includes\": \"Delivery anywhere in Dubai, chafing dishes and table setup\"\n  }\n].map(row => ({ json: row }));"
      },
